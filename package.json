{
  "name": "threshold-v02",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test:unit": "vitest run",
    "test:e2e": "playwright test",
    "test:production": "npm run build && playwright test --config playwright.production.config.ts && node scripts/collect-v02-video.js",
    "build": "tsc --noEmit && vite build",
    "build:test": "tsc --noEmit && vite build --mode e2e",
    "preview": "vite preview --host 0.0.0.0",
    "verify": "npm run typecheck && npm run lint && npm run test:unit && npm run test:e2e && npm run test:production && npm run test:subpath",
    "test:subpath": "node scripts/subpath-smoke.js",
    "measure:software": "node scripts/measure-performance.js",
    "assets:build": "blender -b --python scripts/build-v02-assets.py -- \"$PWD\"",
    "measure:v02": "node scripts/measure-v02.js",
    "assets:orbital": "blender -b --python scripts/build-orbital-assets.py -- \"$PWD\" && node scripts/optimize-orbital-assets.mjs && npm run assets:atelier",
    "test:orbital": "playwright test src/tests/e2e/orbital.spec.ts",
    "capture:orbital": "node scripts/capture-orbital.mjs",
    "deploy:pages": "node scripts/deploy-pages.mjs",
    "measure:orbital": "node scripts/measure-orbital.mjs",
    "assets:atelier": "blender -b --python scripts/build-atelier-assets.py -- \"$PWD\" && node scripts/optimize-orbital-assets.mjs --atelier-only",
    "capture:atelier": "node scripts/capture-atelier.mjs"
  },
  "dependencies": {
    "@dimforge/rapier3d-compat": "0.21.0",
    "@react-three/fiber": "9.8.2",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "three": "0.187.0"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@gltf-transform/cli": "4.5.1",
    "@playwright/test": "1.65.0",
    "@types/node": "26.6.6",
    "@types/pngjs": "6.0.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/three": "0.187.0",
    "@vitejs/plugin-react": "6.2.1",
    "eslint": "10.14.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.14.0",
    "pngjs": "7.0.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1",
    "vite": "8.3.6",
    "vitest": "5.1.0"
  }
}
